# Database
DATABASE_URL=sqlite:///./ear2finger.db

# Optional: Electron desktop app stores downloads/audio under userData if set
# EAR2FINGER_DOWNLOAD_DIR=
# EAR2FINGER_AUDIO_DIR=

# Accounts (sign up / sign in / password reset). Off by default: the desktop
# app runs as a single local user. Set to 1 for a shared web deployment.
# AUTH_ENABLED=1
# Signs login and reset tokens. Required when AUTH_ENABLED is set; generate one
# with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=
# Public address of the web app, used to build the link in reset emails.
# APP_BASE_URL=http://localhost:3000
# SMTP server for password reset emails. When SMTP_HOST is unset the reset link
# is printed to the backend log instead of being mailed.
# Port 587 uses STARTTLS, 465 uses SSL.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Dictypio <no-reply@example.com>

# Qdrant (vector store for AI coach)
# Option A — embedded local storage (no separate Qdrant server). Path must be writable.
# When set, QDRANT_URL / QDRANT_API_KEY are ignored.
# QDRANT_LOCAL_PATH=/path/to/qdrant-local-dir
#
# Option B — HTTP API (Docker or standalone qdrant binary on port 6333).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Must match Gemini output_dimensionality / Qdrant vector size (768 recommended).
QDRANT_VECTOR_SIZE=768
# One-shot: if existing collections use a different size and have points, set to 1 to drop vectors and recreate.
# QDRANT_RECREATE_ON_VECTOR_MISMATCH=1
#
# Rebuild Qdrant collections: from backend/, `python scripts/rebuild_qdrant_collections.py` (loads .env).
# For npm run electron:dev without QDRANT_LOCAL_PATH in .env: add --electron-dev-path to that command.
# Gemini embedding model (legacy models/embedding-001 is not on v1beta).
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Gemini chat model (AI coach). Users still add API keys in Settings.
# GEMINI_MODEL=gemini-3-flash-preview

# Sentence translation. Optional: when set, Google Cloud Translation API v2 is
# used; when unset, translation goes through Gemini with the user's active API
# key from Settings. Create a key in Google Cloud Console with the Cloud
# Translation API enabled.
# GOOGLE_TRANSLATE_API_KEY=
# Seconds to wait for Google before giving up.
# GOOGLE_TRANSLATE_TIMEOUT=15

# YouTube blocks imports from cloud servers (Render) unless they carry a
# signed-in browser's cookies. Path to a Netscape-format cookies.txt; on Render,
# add a Secret File named youtube_cookies.txt instead and leave this unset.
# YOUTUBE_COOKIES_FILE=
